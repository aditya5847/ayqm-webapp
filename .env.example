# Local defaults
AYQM_ENVIRONMENT=local
AYQM_DATABASE_PATH=data/ayqm.duckdb
AYQM_UPLOAD_ROOT=data/uploads
AYQM_EPISODE_ROOT=data/episodes
AYQM_ALLOWED_ORIGINS=http://localhost:5173
AYQM_SESSION_COOKIE_SECURE=false

# Generate these locally. Never commit their real values.
AYQM_ADMIN_PASSWORD_HASH=
AYQM_SESSION_SECRET=

# Production object storage and worker settings
AYQM_STORAGE_BACKEND=local
AYQM_EXTERNAL_TRANSCRIPTION_WORKER=false
AYQM_WORKER_TOKEN=
AYQM_R2_ENDPOINT_URL=
AYQM_R2_BUCKET=
AYQM_R2_ACCESS_KEY_ID=
AYQM_R2_SECRET_ACCESS_KEY=

# Processing credentials
HF_TOKEN=
GEMINI_API_KEY=
AYQM_GEMINI_MODEL=gemini-3.1-flash-lite
AYQM_GEMINI_BUDGET_USD=5

# Production backup scheduler
AYQM_BACKUP_ENABLED=false
AYQM_BACKUP_HOUR_UTC=2
